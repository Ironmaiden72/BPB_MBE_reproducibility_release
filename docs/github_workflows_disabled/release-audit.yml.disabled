name: release-audit
on:
  workflow_dispatch:
  push:
    paths:
      - 'release/**'
      - 'repro_scripts/**'
      - '00_*.csv'
      - '00_*.md'

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Run release audit
        run: python repro_scripts/audit_release.py
      - name: Summarize claims
        run: python repro_scripts/claim_summary.py
